# ─── CREDENCIALES ───────────────────────────────
# Clave de API 
API_KEY=poner_api_key_aqui

# URL base de la API 
BASE_URL=https://api.tu-tms.com/v2

# ─── SERVIDOR ────────────────────────────────────────────────
# Puerto en el que se ejecutará el dashboard
PUERTO=8080

# ─── SEGURIDAD ───────────────────────────────────────────────
# Orígenes permitidos para CORS (separados por coma, sin espacios extra)
# Ejemplo para acceso local:
#   ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Para producción en red local, agregar la IP o nombre del equipo:
#   ALLOWED_ORIGINS=http://192.168.1.1:8080,http://monitor-pc:8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080